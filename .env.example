# Copy to .env for the local lab.  NEVER commit a real .env.
# In non-dev environments, supply every secret from your secret store, not a file.

# --- Postgres ---
POSTGRES_PASSWORD=fleet

# --- Envelope-encryption master key (KEK) for node credentials ---
# Leave EMPTY for the dev lab (a fixed dev key is used automatically).
# REQUIRED outside dev. Generate a real one with:
#     openssl rand -base64 32
FLEET_MASTER_KEY=

# --- Control-plane auth ---
# JWT signing secret. Leave EMPTY for the dev lab (derived from the master key).
# REQUIRED outside dev:  openssl rand -base64 48
FLEET_JWT_SECRET=
# First-run admin (created only if no principals exist yet). Change these, and
# note the admin must enrol TOTP MFA on first login before getting a session.
FLEET_BOOTSTRAP_ADMIN_USER=admin
FLEET_BOOTSTRAP_ADMIN_PASSWORD=changeme-admin-pw

# --- Mock node HMAC credentials (lab only) ---
# These must match what you register for each node in the control plane.
# The smoke-test script reads these to register node-hcmc and node-sg.
HCMC_TOKEN=hcmc-token
HCMC_SECRET=hcmc-secret-change-me
SG_TOKEN=sg-token
SG_SECRET=sg-secret-change-me
